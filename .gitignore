# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# guest list & private docs — contain guest PII, keep out of git
*.xlsx
*.pdf
guest-list-review.csv

# local screenshots
Screenshot*.png

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python virtualenv (used for local guest-import scripts)
.venv/
__pycache__/
*.pyc

# IDE
.idea/
.vscode/

# Claude Code personal settings (keep shared settings.json if/when added)
.claude/settings.local.json

# Project-local tooling caches and review notes
.cache/
.codex-work/

# Downloaded invitation codes contain private guest access data
invitation-codes*.csv
