# Supabase Configuration
# Copy this file to .env.local and fill in your values.
# Find these in your Supabase dashboard: Project Settings -> API.

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# SECRET — server-only. Bypasses Row Level Security. Never prefix with
# NEXT_PUBLIC_ and never paste this anywhere client-side.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase public anon/publishable key, used server-side for account login.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Invitation session signing secret (at least 32 random characters).
# Required when enabling the invitation access feature.
INVITATION_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional honeymoon fund credentials.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Used only by the one-time owner bootstrap script.
SITE_URL=http://localhost:3000
